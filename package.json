{
	"name": "tusch",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''; simple-git-hooks || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . && pnpm run lint:deps",
		"lint:deps": "depcruise src",
		"check:requirements": "node scripts/check-requirements.mjs",
		"knip": "knip",
		"format": "prettier --write .",
		"test": "pnpm run test:e2e",
		"test:e2e": "svelte-kit sync && playwright test",
		"test:e2e:ui": "svelte-kit sync && playwright test --ui",
		"screenshots:update": "scripts/update-screenshots.sh",
		"generate": "plop"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^6.3.5",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^24",
		"dependency-cruiser": "^18.7.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^17.14.0",
		"knip": "^6.44.1",
		"lint-staged": "^17.6.0",
		"plop": "^4.0.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"simple-git-hooks": "^2.14.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.6"
	},
	"dependencies": {
		"openai": "^7.52.0",
		"zod": "^4.6.7"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged",
		"pre-push": "pnpm run check && pnpm run lint && pnpm run --if-present check:requirements"
	},
	"lint-staged": {
		"*.{js,mjs,ts,svelte}": [
			"prettier --write --ignore-unknown",
			"eslint --fix --no-warn-ignored"
		],
		"*.{json,md,yml,yaml,css,html}": "prettier --write --ignore-unknown"
	}
}
